---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import Base from '../layouts/Base.astro';

const published = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const articles = published.filter((a) => a.data.category === 'article');
const fieldNotes = published.filter((a) => a.data.category === 'field');
const setupNotes = published.filter((a) => a.data.category === 'setup');
---

<Base title="Agentic Engineering" description="Notes on building, testing, and shipping agent systems: Claude Code setups, skills, MCP servers, RAG, and CI/CD.">
  <section class="hero">
    <h1>Agentic Engineering</h1>
    <p class="lede">Notes on building, testing, and shipping agent systems. Every claim here should come with code you can run.</p>
  </section>
  <ul class="article-list">
    {articles.map((a) => <ArticleCard article={a} />)}
  </ul>

  {setupNotes.length > 0 && (
    <section class="home-section">
      <h2>Setup notes</h2>
      <p class="section-lede">The workstation behind the work: shell, Git, and tooling.</p>
      <ul class="article-list">
        {setupNotes.map((a) => <ArticleCard article={a} headingLevel={3} />)}
      </ul>
    </section>
  )}

  {fieldNotes.length > 0 && (
    <section class="home-section">
      <h2>Field notes</h2>
      <p class="section-lede">Stories from running real systems in production.</p>
      <ul class="article-list">
        {fieldNotes.map((a) => <ArticleCard article={a} headingLevel={3} />)}
      </ul>
    </section>
  )}
</Base>
