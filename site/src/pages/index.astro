---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readingTime } from '../reading-time';
import { url } from '../url';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'medium' });
---

<Base title="Agentic Engineering" description="Notes on building, testing, and shipping agent systems: Claude Code setups, skills, MCP servers, RAG, and CI/CD.">
  <section class="hero">
    <h1>Agentic Engineering</h1>
    <p class="lede">Notes on building, testing, and shipping agent systems. Every claim here should come with code you can run.</p>
  </section>
  <ul class="article-list">
    {articles.map((a) => (
      <li class="card">
        <p class="card-meta">
          <time datetime={a.data.pubDate.toISOString()}>{fmt.format(a.data.pubDate)}</time>
          <span>{readingTime(a.body)} min read</span>
        </p>
        <h2><a class="title" href={url(`articles/${a.id}/`)}>{a.data.title}</a></h2>
        <p>{a.data.description}</p>
        {a.data.tags.length > 0 && (
          <ul class="tags">{a.data.tags.map((t) => <li>{t}</li>)}</ul>
        )}
        <span class="read-more" aria-hidden="true">Read article →</span>
      </li>
    ))}
  </ul>
</Base>
